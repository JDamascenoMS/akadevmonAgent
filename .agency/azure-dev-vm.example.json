{
  "$schema": "./azure-dev-vm.schema.json",
  "schemaVersion": 1,
  "azure": {
    "tenantId": "11111111-1111-4111-8111-111111111111",
    "subscriptionId": "22222222-2222-4222-8222-222222222222",
    "resourceGroupName": "rg-devvm-example",
    "createResourceGroup": true,
    "location": "westus3",
    "tags": {
      "purpose": "developer-workstation",
      "managedBy": "agency"
    }
  },
  "vm": {
    "name": "devvm-example",
    "size": "Standard_D8s_v5",
    "image": "MicrosoftWindowsDesktop:windows-11:win11-24h2-ent:latest",
    "adminUsername": "vmbootstrap",
    "osDiskSizeGb": 256
  },
  "network": {
    "vnetResourceGroupName": "rg-network-example",
    "vnetName": "vnet-example",
    "subnetName": "snet-developer-vms"
  },
  "access": [
    {
      "principalObjectId": "33333333-3333-4333-8333-333333333333",
      "principalType": "Group",
      "role": "Virtual Machine Administrator Login"
    }
  ],
  "toolchain": {
    "sdkPackages": [
      "Microsoft.DotNet.SDK.10"
    ],
    "visualStudio": {
      "edition": "Enterprise",
      "workloads": [
        "Microsoft.VisualStudio.Workload.ManagedDesktop",
        "Microsoft.VisualStudio.Workload.NetWeb",
        "Microsoft.VisualStudio.Workload.Azure"
      ],
      "components": [
        "Microsoft.VisualStudio.Component.Git"
      ],
      "includeRecommended": true
    }
  },
  "autoShutdown": {
    "time": "1900",
    "timeZone": "Pacific Standard Time"
  }
}
